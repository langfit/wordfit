{
  "name": "wordfit",
  "version": "0.1.1",
  "description": "Correct and naturalise text for a non-native writer, using your own Claude Code agent as the model.",
  "homepage": "https://github.com/langfit/wordfit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langfit/wordfit.git"
  },
  "bugs": {
    "url": "https://github.com/langfit/wordfit/issues"
  },
  "type": "module",
  "bin": {
    "wordfit": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:ext",
    "build:server": "tsc -p tsconfig.json",
    "build:ext": "tsc -p extension/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p extension/tsconfig.json --noEmit",
    "dev": "npm run build && node dist/cli.js serve",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2"
  }
}
